// Instruction-shaped, polymorphic builtins. Matrix destinations are writable
// lvalues; all type checking is performed by SemaRISCV.
class BoscZttBuiltin : TargetBuiltin {
  let Spellings = [NAME];
  let Prototype = "void(...)";
  let Attributes = [CustomTypeChecking, NoThrow];
  let Features = "boscztt";
}

