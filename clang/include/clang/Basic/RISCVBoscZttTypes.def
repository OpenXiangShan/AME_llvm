// Fixed profile-dependent square types. Squares == 0 selects the IR default:
// max(1, 32 / element width) for M, one for ACC. Explicit square counts
// describe the complete register groups needed by mixed-width operations.
#ifndef BOSCZTT_TYPE
#define BOSCZTT_TYPE(Name, Id, SingletonId)
#endif
#ifndef BOSCZTT_MATRIX_TYPE
#define BOSCZTT_MATRIX_TYPE(Name, Id, SingletonId, Element, Width, Squares, Acc) \
  BOSCZTT_TYPE(Name, Id, SingletonId)
#endif

BOSCZTT_MATRIX_TYPE("__boscztt_m_i1_t", BoscZttMI1, BoscZttMI1Ty, Int, 1, 0, false)
BOSCZTT_MATRIX_TYPE("__boscztt_m_i1_x64_t", BoscZttMI1X64, BoscZttMI1X64Ty, Int, 1, 64, false)
